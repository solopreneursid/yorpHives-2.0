{
  "schema_version": 2,
  "project_id": "yorphives-headquarters",
  "display_name": "YorpHives Headquarters",
  "role": "private-monitoring-and-business-intelligence",
  "repository": "solopreneursid/yorpHives-2.0",
  "canonical_checkout": "headquarters",
  "not_the_website": true,
  "sibling_project": {
    "project_id": "yorphives-website",
    "repository": "solopreneursid/YorpHives",
    "canonical_checkout": "website",
    "role": "public-website-and-products"
  },
  "source_roots": [
    "admin/",
    "functions/api/admin/",
    "admin-monitor/",
    "hq-intelligence/",
    "hq-engine/",
    "self-host/"
  ],
  "legacy_website_preview_paths": [
    "index.html",
    "app.js",
    "styles.css",
    "free-tools/",
    "discover/",
    "explore/",
    "listing/",
    "builder/",
    "connect/",
    "functions/api/v1/"
  ],
  "shared_review_required": [
    "brand/",
    "functions/_lib/",
    "functions/_middleware.js",
    "migrations/",
    "package.json",
    ".github/"
  ],
  "operations_policy": {
    "headquarters_can_monitor_both": true,
    "monitoring_target_scope": [
      "website",
      "website-products",
      "headquarters",
      "infrastructure",
      "security",
      "revenue",
      "market",
      "technology",
      "global-opportunities"
    ],
    "automatic_repairs": false,
    "automatic_publishing": false,
    "headquarters_release_controls_enabled": false,
    "headquarters_otp_issuance_enabled": false,
    "founder_implements_and_publishes_outside_headquarters": true,
    "historical_investigation_records_read_only": true,
    "retired_go_live_routes": [
      "/api/admin/go-live",
      "/api/admin/go-live-plan",
      "/api/admin/go-live-otp"
    ]
  }
}
