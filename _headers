/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests

/free-tools/manifest.json
  Link: <https://yorphives.com/free-tools/manifest.json>; rel="canonical"

/.well-known/yorphives.json
  Link: <https://yorphives.com/.well-known/yorphives.json>; rel="canonical"

/openapi.yaml
  Link: <https://yorphives.com/openapi.yaml>; rel="canonical"
