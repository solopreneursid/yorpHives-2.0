{
  "openapi": "3.1.0",
  "info": {
    "title": "YorpHives Capability API",
    "version": "1.0.0",
    "description": "Public, versioned capability discovery and execution API. Public capabilities disclose pricing and data handling before invocation. Identity, scoped API keys, usage metering, credit ledger, and Stripe checkout/webhook/reconciliation routes are included in the trust-commerce preview."
  },
  "servers": [
    {
      "url": "https://yorphives-2-preview.pages.dev"
    }
  ],
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "summary": "Discover available capabilities",
        "responses": {
          "200": {
            "description": "Canonical capability catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "schema_version": {
                          "type": "string"
                        },
                        "capabilities": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Capability"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/execute": {
      "post": {
        "operationId": "executeCapability",
        "summary": "Execute a versioned capability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capability",
                  "version",
                  "input"
                ],
                "properties": {
                  "capability": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "input": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful execution"
          },
          "400": {
            "description": "Invalid request or JSON"
          },
          "404": {
            "description": "Capability or version not found"
          },
          "413": {
            "description": "Payload or input too large"
          },
          "415": {
            "description": "Unsupported media type"
          },
          "422": {
            "description": "Valid request with invalid capability input"
          }
        }
      }
    },
    "/api/mcp": {
      "get": {
        "summary": "MCP endpoint (POST only)",
        "responses": {
          "405": {
            "description": "Use POST for MCP Streamable HTTP"
          }
        }
      },
      "post": {
        "summary": "MCP Streamable HTTP JSON-RPC endpoint",
        "description": "Supports modern stateless MCP 2026-07-28 and legacy handshake MCP 2025-11-25.",
        "responses": {
          "200": {
            "description": "JSON-RPC response"
          },
          "202": {
            "description": "Notification accepted"
          },
          "400": {
            "description": "Protocol version or routing header mismatch"
          },
          "403": {
            "description": "Origin rejected"
          }
        }
      }
    },
    "/api/v1/identity/provision": {
      "post": {
        "operationId": "provisionPrincipal",
        "summary": "Provision a human, developer, agent or service principal",
        "security": [
          {
            "bootstrapSecret": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "kind",
                  "display_name"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "human",
                      "developer",
                      "agent",
                      "service"
                    ]
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "daily_spending_limit_minor": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "monthly_spending_limit_minor": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Principal and one-time API key created"
          },
          "401": {
            "description": "Invalid bootstrap credential"
          },
          "503": {
            "description": "Provisioning disabled until bootstrap secret is configured"
          }
        }
      }
    },
    "/api/v1/identity/me": {
      "get": {
        "operationId": "getCurrentPrincipal",
        "summary": "Get the principal associated with an API credential",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current principal"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient scope"
          }
        }
      }
    },
    "/api/v1/identity/keys": {
      "get": {
        "operationId": "listApiKeys",
        "summary": "List the current principal's API keys",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "API keys without secret hashes"
          },
          "403": {
            "description": "Requires keys:manage"
          }
        }
      },
      "post": {
        "operationId": "createApiKey",
        "summary": "Create a scoped API key",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scopes"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New key returned once"
          },
          "403": {
            "description": "Requires keys:manage"
          }
        }
      },
      "delete": {
        "operationId": "revokeApiKey",
        "summary": "Revoke an API key belonging to the current principal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key revoked"
          },
          "404": {
            "description": "Key not found"
          }
        }
      }
    },
    "/api/v1/identity/grants": {
      "post": {
        "operationId": "upsertCapabilityGrant",
        "summary": "Grant or revoke a capability with explicit quota and spending ceilings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "principal_id",
                  "capability_id"
                ],
                "properties": {
                  "principal_id": {
                    "type": "string"
                  },
                  "capability_id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "daily_unit_limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "daily_spending_limit_minor": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "per_execution_limit_minor": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capability grant updated"
          },
          "403": {
            "description": "Requires capabilities:grant"
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Read metered usage for the current principal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usage totals and events"
          },
          "403": {
            "description": "Requires usage:read"
          }
        }
      }
    },
    "/api/v1/commerce/credits": {
      "get": {
        "operationId": "getCreditBalance",
        "summary": "Read the current credit balance and immutable credit entries",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credit balance and ledger entries"
          },
          "403": {
            "description": "Requires credits:read"
          }
        }
      }
    },
    "/api/v1/commerce/checkout": {
      "post": {
        "operationId": "createCreditCheckout",
        "summary": "Create a checkout session for a server-configured credit pack",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pack_id"
                ],
                "properties": {
                  "pack_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Checkout session created"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "503": {
            "description": "Commerce is not configured"
          }
        }
      }
    },
    "/api/v1/commerce/reconcile": {
      "post": {
        "operationId": "reconcileStripeOrders",
        "summary": "Reconcile pending Stripe checkout sessions against provider state",
        "security": [
          {
            "reconcileSecret": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reconciliation summary"
          },
          "401": {
            "description": "Invalid reconciliation credential"
          },
          "503": {
            "description": "Reconciliation not configured"
          }
        }
      }
    },
    "/api/webhooks/stripe": {
      "post": {
        "operationId": "receiveStripeWebhook",
        "summary": "Receive and verify Stripe payment events",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event acknowledged or order settled"
          },
          "400": {
            "description": "Invalid signature or webhook payload"
          },
          "409": {
            "description": "Payment not matched to a YorpHives order"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Check API and database health",
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Degraded"
          }
        }
      }
    },
    "/api/v1/commerce/orders": {
      "get": {
        "operationId": "listCommerceOrders",
        "summary": "List the current principal's purchase history and order status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase history"
          },
          "403": {
            "description": "Requires commerce:orders:read"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "description",
          "status",
          "input_schema",
          "output_schema",
          "access",
          "pricing",
          "execution",
          "data_handling"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "available",
              "testing",
              "maintenance",
              "retired"
            ]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "access": {
            "type": "object"
          },
          "pricing": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "data_handling": {
            "type": "object"
          },
          "safety": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "YorpHives API key"
      },
      "bootstrapSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-YorpHives-Bootstrap"
      },
      "reconcileSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-YorpHives-Reconcile"
      }
    }
  }
}
