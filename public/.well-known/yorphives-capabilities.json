{
  "manifest_version": "1.0",
  "name": "YorpHives",
  "description": "An open capability network for people and AI agents.",
  "website": "https://yorphives-2-preview.pages.dev",
  "catalog": "https://yorphives-2-preview.pages.dev/api/v1/capabilities",
  "openapi": "https://yorphives-2-preview.pages.dev/openapi.json",
  "llms": "https://yorphives-2-preview.pages.dev/llms.txt",
  "protocols": [
    {
      "name": "http-json",
      "version": "1",
      "endpoint": "https://yorphives-2-preview.pages.dev/api/v1/execute",
      "discovery": "https://yorphives-2-preview.pages.dev/openapi.json"
    },
    {
      "name": "mcp",
      "transport": "streamable-http",
      "endpoint": "https://yorphives-2-preview.pages.dev/api/mcp",
      "protocol_versions": [
        "2026-07-28",
        "2025-11-25"
      ]
    }
  ],
  "principles": {
    "capability_contracts": "versioned",
    "pricing_disclosed_before_execution": true,
    "authorization_explicit": true,
    "execution_results_structured": true,
    "data_handling_disclosed": true
  },
  "catalog_version": "1.0.0",
  "status": "early-access",
  "identity": {
    "principal_types": [
      "human",
      "developer",
      "agent",
      "service"
    ],
    "authentication": "bearer-api-key",
    "key_management": "/api/v1/identity/keys",
    "principal_endpoint": "/api/v1/identity/me",
    "bootstrap_endpoint": "/api/v1/identity/provision",
    "scopes": [
      "identity:read",
      "capability:execute",
      "usage:read",
      "credits:read",
      "keys:manage",
      "commerce:checkout",
      "capabilities:grant",
      "commerce:orders:read"
    ]
  },
  "commerce": {
    "credit_balance": "/api/v1/commerce/credits",
    "checkout": "/api/v1/commerce/checkout",
    "usage": "/api/v1/usage",
    "payment_webhook": "/api/webhooks/stripe",
    "provider_reconciliation": "/api/v1/commerce/reconcile",
    "pricing": "server-configured-credit-packs",
    "orders": "/api/v1/commerce/orders"
  },
  "trust": {
    "api_keys_hashed_at_rest": true,
    "credential_scopes": true,
    "capability_grants": true,
    "rate_limits": true,
    "spending_ceilings": true,
    "append_only_ledgers": true,
    "payment_webhook_signature_verification": true
  }
}
